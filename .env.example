# Copy to .env (git-ignored) or set these in your shell before `npm start`.

# Server port (default 3000)
# PORT=3000

# --- Real phone push via ntfy.sh (optional, free, no account) ---
# Pick a long, hard-to-guess topic, then subscribe to the same topic in the
# ntfy mobile app (iOS/Android) or at https://ntfy.sh/<topic>.
# NTFY_TOPIC=swivel-sentio-demo-7f3k9q

# Optional self-hosted ntfy server (default https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh

# Optional: a PUBLIC URL for THIS server so the phone notification gets
# tappable Veto / Approve buttons that call /api/caregiver/decision.
# Get one for free with Tailscale Funnel (`tailscale funnel 3000`) or ngrok.
# PUBLIC_BASE_URL=https://your-machine.tailxxxx.ts.net

# --- Natural AI voice via ElevenLabs (optional) ---
# Without a key the app uses the best voice your browser has (Edge "Natural" voices sound best).
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # "Sarah" (default; free-tier premade voice)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Google Gemini scam analysis (optional; falls back to offline keyword rules) ---
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# --- Tiger Data / Tiger Cloud (optional; falls back to an in-memory store) ---
# DATABASE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
